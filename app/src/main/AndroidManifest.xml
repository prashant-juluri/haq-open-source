<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        INTERNET is the ONE exception to the no-network rule.
        It is used solely for the one-time first-launch model download.
        All inference is offline. Core features work in airplane mode.
    -->
    <!-- One-time model download only. All inference is offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WiFi check before download (ConnectivityManager) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Whisper STT: microphone access -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- BiometricPrompt: face unlock + fingerprint -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />

    <!-- Vibration for mic-active feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Haq"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <!-- Bundle ML Kit OCR models on-device so no network download is needed -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr_latin,ocr_devanagari" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
